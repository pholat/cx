// Cx wrapper over klib's hash map (submodules/klib/khash.h).
//
// The khash macro instantiation and heap storage live in the hand-written C
// bridge (klib_bridge.c); this file exposes a namespaced, value-based API.

// --- C bridge, defined in klib_bridge.c (global scope: unmangled) ----------
int  kl_map_new();
void kl_map_free(int handle);
int  kl_map_size(int handle);
int  kl_map_empty(int handle);
void kl_map_put(int handle, int key, int value);
int  kl_map_get(int handle, int key, int fallback);
int  kl_map_has(int handle, int key);
void kl_map_del(int handle, int key);

namespace container {

    // An int -> int map. Holds only the bridge handle; lifetime is manual
    // (call map_free), so copies and returns are cheap and safe.
    struct Map {
        int handle;

        Map(int h) {
            handle = h;
        }
    };

    Map map_new() {
        Map m(kl_map_new());
        return m;
    }

    void map_free(Map m) {
        kl_map_free(m.handle);
    }

    int map_size(Map m) {
        return kl_map_size(m.handle);
    }

    int map_is_empty(Map m) {
        return kl_map_empty(m.handle);
    }

    void map_put(Map m, int key, int value) {
        kl_map_put(m.handle, key, value);
    }

    // Returns the stored value, or `fallback` when the key is absent.
    int map_get(Map m, int key, int fallback) {
        return kl_map_get(m.handle, key, fallback);
    }

    int map_has(Map m, int key) {
        return kl_map_has(m.handle, key);
    }

    void map_del(Map m, int key) {
        kl_map_del(m.handle, key);
    }
}
