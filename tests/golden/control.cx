namespace demo {

    int sum_to(int n) {
        int total = 0;
        int i = 1;
        while (i <= n) {
            total = total + i;
            i = i + 1;
        }
        return total;
    }

    int sign(int n) {
        if (n < 0) {
            return -1;
        } else {
            if (n > 0) {
                return 1;
            } else {
                return 0;
            }
        }
    }

    int first_multiple_of(int n, int divisor) {
        int i = 1;
        for (i = 1; i <= n; i = i + 1) {
            if (i < divisor) {
                continue;
            }
            if ((i / divisor) * divisor == i) {
                return i;
            }
        }
        return 0;
    }

    int first_positive(int n) {
        int i = 0;
        while (i < n) {
            if (i > 0) {
                break;
            }
            i = i + 1;
        }
        return i;
    }
}
