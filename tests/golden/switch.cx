namespace demo {

    int classify(int n) {
        int result = 0;
        switch (n) {
            case 0:
                result = 10;
                break;
            case 1:
                result = 20;
                break;
            default:
                result = 30;
                break;
        }
        return result;
    }

    int countdown(int n) {
        int total = 0;
    again:
        total = total + n;
        n = n - 1;
        if (n > 0) {
            goto again;
        }
        return total;
    }
}
