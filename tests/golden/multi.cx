namespace demo {

    struct Pair {
        int a, b;
    };

    int sum(int a, int b, int c) {
        return a + b + c;
    }

    int run() {
        int a = 1, b = 2, c = 3;
        int x, y, z;
        x = a;
        y = b;
        z = c;
        Pair p;
        p.a = x;
        p.b = y;
        return sum(p.a, p.b, z);
    }
}
