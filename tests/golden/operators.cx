namespace demo {

    int sum(int n) {
        int total = 0;
        int i = 0;
        for (i = 0; i < n; i++) {
            total += i;
        }
        return total;
    }

    int mix(int a, int b) {
        int x = a & b;
        x = x | (a ^ b);
        x = x << 1;
        x = x >> 1;
        return x;
    }

    int truthy(int x) {
        return !x;
    }

    int negate(int x) {
        return ~x;
    }
}
