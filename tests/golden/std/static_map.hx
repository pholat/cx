// A fixed-capacity ("static") map, generated by `macro_rules!` over the
// `Hashable` / `Equatable` capability traits. It never allocates: the slots are
// real struct fields, one triple per slot name passed to the macro, so the map
// lives entirely in the value that declares it.
//
//     import "std/static_map.hx";
//
//     struct Key {
//         int id;
//         Key(int id_) { id = id_; }
//         implements Hashable  { int hash(self)          { return self->id; } }
//         implements Equatable { int equals(self, void *o) { return self->id == ((Key *)o)->id; } }
//     };
//
//     define_static_map!(KeyMap, Key, int, s0 s1 s2 s3 s4 s5 s6 s7);
//
// The key type must implement both interfaces (checked after expansion); the
// map stores up to as many entries as there are slot names, and linearly probes
// the slots. Methods use the `.`-method spelling — `m.put(&k, v)`,
// `m.get(&k, 0)`, `m.has(&k)`, `m.remove(&k)`, `m.size()`, `m.clear()`.

// The capability interfaces. A struct used as a static-map key declares
// `implements Hashable` / `implements Equatable`; `hash` returns a bucket hint
// and `equals` compares two keys (the second as a `void *` so the interface
// needs no associated key type).
trait Hashable {
    int hash(self);
}

trait Equatable {
    int equals(self, void *other);
}

macro_rules! define_static_map {
    ($name:ident, $k:ty, $v:ty, $($slot:ident)*)
        requires $k: Hashable + Equatable
    => {
        struct $name {
            $($k $slot##_key; $v $slot##_val; int $slot##_used;)*
            int n;
        };

        int $name::size($name *m) {
            return m->n;
        }

        void $name::clear($name *m) {
            $(m->$slot##_used = 0;)*
            m->n = 0;
        }

        // The value stored under `key`, or `fallback` when absent. Compares
        // through the key's `Equatable` vtable.
        $v $name::get($name *m, $k *key, $v fallback) {
            int (*eq)(void *, void *) = key->Equatable->equals;
            $(
                if (m->$slot##_used != 0 && eq(&m->$slot##_key, key) != 0) {
                    return m->$slot##_val;
                }
            )*
            return fallback;
        }

        int $name::has($name *m, $k *key) {
            int (*eq)(void *, void *) = key->Equatable->equals;
            $(
                if (m->$slot##_used != 0 && eq(&m->$slot##_key, key) != 0) {
                    return 1;
                }
            )*
            return 0;
        }

        // Insert or update. Returns 1 if a new slot was used, 0 if an existing
        // key was updated, and -1 if the map is full.
        int $name::put($name *m, $k *key, $v value) {
            int (*eq)(void *, void *) = key->Equatable->equals;
            $(
                if (m->$slot##_used != 0 && eq(&m->$slot##_key, key) != 0) {
                    m->$slot##_val = value;
                    return 0;
                }
            )*
            $(
                if (m->$slot##_used == 0) {
                    m->$slot##_key = *key;
                    m->$slot##_val = value;
                    m->$slot##_used = 1;
                    m->n += 1;
                    return 1;
                }
            )*
            return -1;
        }

        void $name::remove($name *m, $k *key) {
            int (*eq)(void *, void *) = key->Equatable->equals;
            $(
                if (m->$slot##_used != 0 && eq(&m->$slot##_key, key) != 0) {
                    m->$slot##_used = 0;
                    m->n -= 1;
                    return;
                }
            )*
        }
    };
}
