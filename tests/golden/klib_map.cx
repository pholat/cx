#include "khash.h"

// C helper. khash keeps values behind a typed `vals` array, and Cx cannot name
// `khash_t(<Name>)` (a type is a single token). A per-instantiation C macro
// emits typed accessors over a `void *` handle, so the Cx wrapper never has to
// spell the generated khash type.
raw {
    #define CX_KHASH_MAP_HELPERS(name, val_t) \
        static int cx_##name##_put(void *h, int key, val_t value) { \
            int ok = 0; \
            kh_##name##_t *t = (kh_##name##_t *)h; \
            khint_t it = kh_put_##name(t, key, &ok); \
            t->vals[it] = value; \
            return ok; \
        } \
        static val_t cx_##name##_get(void *h, int key, val_t fallback) { \
            kh_##name##_t *t = (kh_##name##_t *)h; \
            khint_t it = kh_get_##name(t, key); \
            if (it == kh_end(t)) return fallback; \
            return t->vals[it]; \
        } \
        static int cx_##name##_has(void *h, int key) { \
            kh_##name##_t *t = (kh_##name##_t *)h; \
            return kh_get_##name(t, key) != kh_end(t); \
        } \
        static void cx_##name##_del(void *h, int key) { \
            kh_##name##_t *t = (kh_##name##_t *)h; \
            khint_t it = kh_get_##name(t, key); \
            if (it != kh_end(t)) kh_del_##name(t, it); \
        }
}

// A macro-defined, khash-backed map with integer keys. `KHASH_MAP_INIT_INT!`
// and `CX_KHASH_MAP_HELPERS!` are C-macro passthroughs; the generated khash
// symbols are named `kh_init_<Name>`, `kh_put_<Name>`, … The Cx wrapper stores
// the table as `void *` (Cx types cannot express `khash_t(<Name>)`) and tracks
// the element count itself, because `kh_size` would need the typed handle.
//
// Public method spelling is `$name::new` / `::put` / `::get` / `::has` /
// `::del` / `::size` / `::free`; the expander rewrites `$name::m` to
// `Name__m` and records the origin for LSP go-to-definition.
macro_rules! define_int_map {
    ($name:ident, $v:ty) => {
        KHASH_MAP_INIT_INT!($name, $v);
        CX_KHASH_MAP_HELPERS!($name, $v);

        struct $name {
            void *h;
            int n;
        };

        $name $name::new() {
            $name m;
            m.h = kh_init_##$name();
            m.n = 0;
            return m;
        }

        void $name::put($name *m, int key, $v value) {
            int added = cx_##$name##_put(m->h, key, value);
            if (added != 0) {
                m->n += 1;
            }
        }

        $v $name::get($name *m, int key, $v fallback) {
            return cx_##$name##_get(m->h, key, fallback);
        }

        int $name::has($name *m, int key) {
            return cx_##$name##_has(m->h, key);
        }

        void $name::del($name *m, int key) {
            if (cx_##$name##_has(m->h, key) != 0) {
                cx_##$name##_del(m->h, key);
                m->n -= 1;
            }
        }

        int $name::size($name *m) {
            return m->n;
        }

        void $name::free($name *m) {
            kh_destroy_##$name(m->h);
            m->h = 0;
            m->n = 0;
        }
    };
}

namespace demo {

    define_int_map!(IntMap, int);

    int run() {
        IntMap m = IntMap::new();
        IntMap::put(&m, 1, 10);
        IntMap::put(&m, 2, 20);
        IntMap::put(&m, 1, 11); /* overwrite: the count stays 2 */

        int a = IntMap::get(&m, 1, 0);
        int b = IntMap::get(&m, 9, -1);
        int n = IntMap::size(&m);
        int has = IntMap::has(&m, 2);

        IntMap::del(&m, 2);
        IntMap::free(&m);
        return a + b + n + has;
    }
}
