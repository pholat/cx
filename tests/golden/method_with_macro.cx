#include "klist.h"

// klist's pool free callback (it applies to the internal nodes, not the element
// data). One shared no-op is enough here.
raw {
    static void cx_nofree(void *p) { (void)p; }
}

// The interface (trait) an element type must provide to live in the container.
trait Drop {
    void drop(self);
}

// A macro-defined, klib-backed vector of `$t *` elements. The element type is
// constrained with `requires $t: Drop` (checked after expansion/sema), so a
// non-conforming element type is a compile-time error. klist stores `void *`
// slots, so the concrete element type appears only in Cx-generated code and
// never inside the klib C macro (which cannot name a mangled Cx struct type).
//
// The public method spelling is `$name::new` / `::push` / `::size` / `::free`;
// call sites use the `.`-method form (`vec.push(&item)`), which lowers to the
// associated call `Vec__push(&vec, &item)`.
macro_rules! define_vec {
    ($name:ident, $t:ty) requires $t: Drop => {
        KLIST_INIT!($name, void *, cx_nofree);

        struct $name {
            void *v;
            int n;
        };

        $name $name::new() {
            $name b;
            b.v = kl_init_##$name();
            b.n = 0;
            return b;
        }

        void $name::push($name *b, $t *item) {
            $t **slot = ($t **) kl_pushp_##$name(b->v);
            *slot = item;
            b->n += 1;
        }

        int $name::size($name *b) {
            return b->n;
        }

        void $name::free($name *b) {
            // Element teardown: pop each stored `$t *` and invoke its interface
            // method (`Drop::drop`) through the installed vtable.
            void *item;
            while (kl_shift_##$name(b->v, &item) == 0) {
                $t *p = ($t *) item;
                void (*dropfn)(void *) = p->Drop->drop;
                dropfn(p);
            }
            kl_destroy_##$name(b->v);
            b->v = 0;
            b->n = 0;
        }
    };
}

namespace demo {

    struct Box {
        int v;

        Box(int x) {
            v = x;
        }

        implements Drop {
            void drop(self) {
                self->v = 0;
            }
        }
    };

    // `Box` implements `Drop`, so the `requires` bound is satisfied. Invoking
    // `define_vec!(Plain, …)` on a struct without `Drop` would be an error.
    define_vec!(BoxVec, Box);

    // Fill the interface-constrained, macro-defined container with the
    // `.`-method spelling.
    int run() {
        Box a(1);
        Box b(2);

        BoxVec vec = BoxVec::new();
        vec.push(&a);
        vec.push(&b);
        int n = vec.size();

        // Reach the interface method through the installed vtable.
        void (*dropfn)(void *) = a.Drop->drop;
        dropfn(&a);

        vec.free();
        return n + a.v;
    }
}
