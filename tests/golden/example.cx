#include "klist.h"

// See `klib_list.cx` for the full explanation of the klib bridge. This example
// uses the `.`-method spelling: `list.push(…)` lowers to `IntList__push(&list,
// …)`, so the LSP offers `push` (and the other members) right after `list.`.
raw {
    static void cx_nofree(void *p) { (void)p; }
}

macro_rules! define_list {
    ($name:ident, $t:ty) => {
        KLIST_INIT!($name, $t, cx_nofree);

        struct $name {
            void *v;
            int n;
        };

        $name $name::new() {
            $name l;
            l.v = kl_init_##$name();
            l.n = 0;
            return l;
        }

        void $name::push($name *l, $t value) {
            $t *p = kl_pushp_##$name(l->v);
            *p = value;
            l->n += 1;
        }

        $t $name::pop($name *l, $t fallback) {
            $t out;
            if (kl_shift_##$name(l->v, &out) == 0) {
                l->n -= 1;
                return out;
            }
            return fallback;
        }

        int $name::size($name *l) {
            return l->n;
        }

        void $name::free($name *l) {
            kl_destroy_##$name(l->v);
            l->v = 0;
            l->n = 0;
        }
    };
}

namespace demo {

    define_list!(IntList, int);

    // Fill the list element by element with the `.`-method spelling.
    int run() {
        IntList list = IntList::new();

        list.push(1);
        list.push(2);
        list.push(3);
        list.push(4);

        int total = 0;
        total += list.pop(0);
        total += list.pop(0);

        int n = list.size();
        list.free();
        return total + n;
    }
}
